# Copy to .env.docker and customize before Docker deployments.

# Host port published by docker-compose (maps to container port 8000).
VEP_LINK_HOST_PORT=8021

# Hosted MCP HTTP service transport.
VEP_LINK_MCP_TRANSPORT=unified
VEP_LINK_MCP_HOST=0.0.0.0
VEP_LINK_MCP_PORT=8000
VEP_LINK_MCP_PATH=/mcp
VEP_LINK_MCP_ALLOWED_HOSTS='["localhost","127.0.0.1","::1","vep-link.genefoundry.org"]'
VEP_LINK_MCP_ALLOWED_ORIGINS='["https://vep-link.genefoundry.org"]'

# Logging.
VEP_LINK_LOG_LEVEL=INFO
VEP_LINK_LOG_FORMAT=json

# Ensembl REST hosts (GRCh38 / GRCh37) and default assembly.
VEP_LINK_VEP_GRCH38_URL=https://rest.ensembl.org
VEP_LINK_VEP_GRCH37_URL=https://grch37.rest.ensembl.org
VEP_LINK_DEFAULT_ASSEMBLY=GRCh38

# Request handling / resilience.
VEP_LINK_REQUEST_TIMEOUT=60
VEP_LINK_MAX_CONCURRENCY=5
VEP_LINK_MAX_RETRIES=4

# Batch POST chunking (Ensembl region/recoder POST limits).
VEP_LINK_CHUNK_SIZE=200
VEP_LINK_BATCH_MAX=200

# In-process cache.
VEP_LINK_CACHE_SIZE=1024
VEP_LINK_CACHE_TTL_SECONDS=86400

# CORS.
VEP_LINK_CORS_ORIGINS=https://vep-link.genefoundry.org
