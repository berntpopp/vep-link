# vep-link configuration (env prefix VEP_LINK_). Copy to .env and adjust.

# --- Ensembl REST hosts (build-specific) ---
VEP_LINK_VEP_GRCH38_URL=https://rest.ensembl.org
VEP_LINK_VEP_GRCH37_URL=https://grch37.rest.ensembl.org
VEP_LINK_DEFAULT_ASSEMBLY=GRCh38

# --- Request handling / resilience ---
# Tuned so a synchronous MCP tool call fails fast + cleanly when Ensembl is
# unhealthy. OVERALL_DEADLINE_SECONDS is a hard wall-clock cap on one logical
# request across all retries (each attempt's timeout is shrunk to what remains).
VEP_LINK_REQUEST_TIMEOUT=30
VEP_LINK_CONNECT_TIMEOUT=10.0
VEP_LINK_OVERALL_DEADLINE_SECONDS=45.0
VEP_LINK_MAX_CONCURRENCY=5
VEP_LINK_QUEUE_WAIT_TIMEOUT=20
VEP_LINK_MAX_RETRIES=2
VEP_LINK_BACKOFF_BASE_SECONDS=1.0
VEP_LINK_BACKOFF_MAX_SECONDS=20.0

# --- VEP annotation profile (not env-tunable; documented here) ---
# Every annotate call enables these Ensembl REST toggles by default:
#   CADD, REVEL, AlphaMissense, Conservation (GERP), hgvs, mane, numbers,
#   canonical, domains. REVEL/AlphaMissense/CADD/GERP are precomputed
#   pathogenicity/conservation scores served by the public REST. Callers may
#   override per-call via the annotate tools' `vep_options` (allowlist-checked).

# --- Batch POST chunking ---
VEP_LINK_CHUNK_SIZE=200
VEP_LINK_BATCH_MAX=200
VEP_LINK_INTER_CHUNK_DELAY_MS=100

# --- In-process cache ---
VEP_LINK_CACHE_SIZE=1024
VEP_LINK_CACHE_TTL_SECONDS=86400

# --- Upstream health monitoring (per-assembly circuit breaker + background probe) ---
VEP_LINK_HEALTH_PROBE_ENABLED=true
VEP_LINK_HEALTH_PROBE_INTERVAL_SECONDS=60
VEP_LINK_HEALTH_PROBE_TIMEOUT=8
VEP_LINK_CIRCUIT_FAILURE_THRESHOLD=3
VEP_LINK_CIRCUIT_COOLDOWN_SECONDS=30

# --- Transport ---
VEP_LINK_MCP_TRANSPORT=unified
VEP_LINK_MCP_HOST=127.0.0.1
VEP_LINK_MCP_PORT=8000
VEP_LINK_MCP_PATH=/mcp
VEP_LINK_MCP_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
VEP_LINK_MCP_ALLOWED_ORIGINS='[]'

# --- Logging ---
VEP_LINK_LOG_LEVEL=INFO
VEP_LINK_LOG_FORMAT=json

# --- Server ---
VEP_LINK_CORS_ORIGINS=*
VEP_LINK_USER_AGENT=vep-link/0.1 (research MCP; +https://github.com/berntpopp/vep-link)
