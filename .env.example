# vep-link configuration (env prefix VEP_LINK_). Copy to .env and adjust.

# --- Ensembl REST hosts (build-specific) ---
VEP_LINK_VEP_GRCH38_URL=https://rest.ensembl.org
VEP_LINK_VEP_GRCH37_URL=https://grch37.rest.ensembl.org
VEP_LINK_DEFAULT_ASSEMBLY=GRCh38

# --- Request handling / resilience ---
VEP_LINK_REQUEST_TIMEOUT=60
VEP_LINK_MAX_CONCURRENCY=5
VEP_LINK_QUEUE_WAIT_TIMEOUT=20
VEP_LINK_MAX_RETRIES=4
VEP_LINK_BACKOFF_BASE_SECONDS=1.0
VEP_LINK_BACKOFF_MAX_SECONDS=20.0

# --- Batch POST chunking ---
VEP_LINK_CHUNK_SIZE=200
VEP_LINK_BATCH_MAX=200
VEP_LINK_INTER_CHUNK_DELAY_MS=100

# --- In-process cache ---
VEP_LINK_CACHE_SIZE=1024
VEP_LINK_CACHE_TTL_SECONDS=86400

# --- Transport ---
VEP_LINK_MCP_TRANSPORT=unified
VEP_LINK_MCP_HOST=127.0.0.1
VEP_LINK_MCP_PORT=8000
VEP_LINK_MCP_PATH=/mcp

# --- Logging ---
VEP_LINK_LOG_LEVEL=INFO
VEP_LINK_LOG_FORMAT=json

# --- Server ---
VEP_LINK_CORS_ORIGINS=*
VEP_LINK_USER_AGENT=vep-link/0.1 (research MCP; +https://github.com/berntpopp/vep-link)
